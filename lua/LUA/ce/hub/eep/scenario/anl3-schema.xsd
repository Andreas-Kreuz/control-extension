        <xs:element ref="Modell"/>
        <xs:element ref="Table"/>
      </xs:choice>
      <xs:attribute name="GoodIdx" type="xs:string"/>
      <xs:attribute name="LockEd"  type="BoolFlag"/>
      <xs:attribute name="gsbname" type="xs:string"/>
      <xs:attribute name="u1"      type="xs:string"/>
      <xs:attribute name="u2"      type="xs:string"/>
      <xs:attribute name="u3"      type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="AVel">
    <xs:complexType>
      <xs:attribute name="x" type="xs:string"/>
      <xs:attribute name="y" type="xs:string"/>
      <xs:attribute name="z" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="LVel">
    <xs:complexType>
      <xs:attribute name="x" type="xs:string"/>
      <xs:attribute name="y" type="xs:string"/>
      <xs:attribute name="z" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       Crowd Simulation
       ==================================================================== -->

  <xs:element name="CrowdSammlung">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Crowd" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Crowd">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Dreibein"/>
        <xs:element ref="Force"/>
        <xs:element ref="Sink"/>
        <xs:element ref="Source"/>
        <xs:element ref="Zwangskraft"/>
      </xs:choice>
      <xs:attribute name="ID"   type="xs:string"/>
      <xs:attribute name="Name" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Force">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Dreibein"/>
        <xs:element ref="Vektor"/>
      </xs:choice>
      <xs:attribute name="Active"        type="xs:string"/>
      <xs:attribute name="Amplification" type="xs:string"/>
      <xs:attribute name="ForceType"     type="xs:string"/>
      <xs:attribute name="MaxRange"      type="xs:string"/>
      <xs:attribute name="MinRange"      type="xs:string"/>
      <xs:attribute name="Range"         type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Sink">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Dreibein"/>
        <xs:element ref="KontaktZiel"/>
      </xs:choice>
      <xs:attribute name="Active"   type="xs:string"/>
      <xs:attribute name="MaxRange" type="xs:string"/>
      <xs:attribute name="MinRange" type="xs:string"/>
      <xs:attribute name="Range"    type="xs:string"/>
      <xs:attribute name="SinkSide" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Source">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Dreibein"/>
        <xs:element ref="KontaktZiel"/>
        <xs:element ref="ModelType"/>
      </xs:choice>
      <xs:attribute name="Active"               type="xs:string"/>
      <xs:attribute name="MaxRange"             type="xs:string"/>
      <xs:attribute name="MaximumFlockSize"     type="xs:string"/>
      <xs:attribute name="MaximumOmegaCount"    type="xs:string"/>
      <xs:attribute name="MinRange"             type="xs:string"/>
      <xs:attribute name="MinimumFlockSize"     type="xs:string"/>
      <xs:attribute name="ProductionRate"       type="xs:string"/>
      <xs:attribute name="Range"                type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="ModelType">
    <xs:complexType mixed="true"/>
  </xs:element>

  <xs:element name="Zwangskraft">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Dreibein" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="Active"         type="xs:string"/>
      <xs:attribute name="Damping"        type="xs:string"/>
      <xs:attribute name="Depth"          type="xs:string"/>
      <xs:attribute name="Height"         type="xs:string"/>
      <xs:attribute name="Limit"          type="xs:string"/>
      <xs:attribute name="MaxRange"       type="xs:string"/>
      <xs:attribute name="MinRange"       type="xs:string"/>
      <xs:attribute name="Range"          type="xs:string"/>
      <xs:attribute name="Width"          type="xs:string"/>
      <xs:attribute name="ZwangskraftType" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       Cameras
       ==================================================================== -->

  <xs:element name="Kamera3D">
    <!-- CamIdx0–CamIdx169, Progress, cnt, id; allow any -->
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kammera" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Kammerasammlung">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Kammera" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="cnt" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Kammera">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Dir"/>
        <xs:element ref="Dreibein"/>
        <xs:element ref="Gleisort"/>
        <xs:element ref="Gleisort2"/>
        <xs:element ref="Look1"/>
      </xs:choice>
      <xs:attribute name="DOF"          type="xs:string"/>
      <xs:attribute name="DOFShiftFar"  type="xs:string"/>
      <xs:attribute name="DOFShiftNear" type="xs:string"/>
      <xs:attribute name="DOFSubDist"   type="xs:string"/>
      <xs:attribute name="Duration"     type="xs:string"/>
      <xs:attribute name="Dynamic"      type="xs:string"/>
      <xs:attribute name="FOV"          type="xs:string"/>
      <xs:attribute name="FStopIdx"     type="xs:string"/>
      <xs:attribute name="FocalIdx"     type="xs:string"/>
      <xs:attribute name="Geschwindigkeit" type="xs:string"/>
      <xs:attribute name="Gyroscope"    type="xs:string"/>
      <xs:attribute name="Interpolate"  type="xs:string"/>
      <xs:attribute name="MarkedZOfs"   type="xs:string"/>
      <xs:attribute name="NextID"       type="xs:string"/>
      <xs:attribute name="PPFilter"     type="xs:string"/>
      <xs:attribute name="PPParam_W"    type="xs:string"/>
      <xs:attribute name="PPParam_X"    type="xs:string"/>
      <xs:attribute name="PPParam_Y"    type="xs:string"/>
      <xs:attribute name="PPParam_Z"    type="xs:string"/>
      <xs:attribute name="Select"       type="xs:string"/>
      <xs:attribute name="SleepB"       type="xs:string"/>
      <xs:attribute name="SleepE"       type="xs:string"/>
      <xs:attribute name="SubDist"      type="xs:string"/>
      <xs:attribute name="TakeSwitch"   type="xs:string"/>
      <xs:attribute name="TrainID"      type="xs:string"/>
      <xs:attribute name="id"           type="xs:string"/>
      <xs:attribute name="name"         type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Dir">
    <xs:complexType>
      <xs:attribute name="x" type="xs:string"/>
      <xs:attribute name="y" type="xs:string"/>
      <xs:attribute name="z" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Look1">
    <xs:complexType>
      <xs:attribute name="x" type="xs:string"/>
      <xs:attribute name="y" type="xs:string"/>
      <xs:attribute name="z" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Gleisort">
    <xs:complexType>
      <xs:attribute name="ausrichtung"  type="xs:string"/>
      <xs:attribute name="gleisID"      type="xs:string"/>
      <xs:attribute name="gleissystemID" type="xs:string"/>
      <xs:attribute name="parameter"    type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Gleisort2">
    <xs:complexType>
      <xs:attribute name="ausrichtung"  type="xs:string"/>
      <xs:attribute name="gleisID"      type="xs:string"/>
      <xs:attribute name="gleissystemID" type="xs:string"/>
      <xs:attribute name="parameter"    type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       Kollektor (track collector)
       ==================================================================== -->

  <xs:element name="Kollektor">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Dreibein"/>
        <xs:element ref="Gleis"/>
      </xs:choice>
      <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       Shared geometry / model elements
       ==================================================================== -->

  <xs:element name="Dreibein">
    <!-- Coordinate frame (3 vectors) -->
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Vektor" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Vektor">
    <xs:complexType>
      <xs:attribute name="x" type="xs:string"/>
      <xs:attribute name="y" type="xs:string"/>
      <xs:attribute name="z" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Modell">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Achse"/>
        <xs:element ref="Table"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="Achse">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Achse" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="Parameter" type="xs:string"/>
      <xs:attribute name="Velocity"  type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Text3DM">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="TexText" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="TexText">
    <xs:complexType>
      <xs:attribute name="BgCol"  type="xs:string"/>
      <xs:attribute name="Center" type="xs:string"/>
      <xs:attribute name="FgCol"  type="xs:string"/>
      <xs:attribute name="FntDat" type="xs:string"/>
      <xs:attribute name="Font"   type="xs:string"/>
      <xs:attribute name="Idx"    type="xs:string"/>
      <xs:attribute name="Text"   type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Frame">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Position"/>
        <xs:element ref="Vector"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="Position">
    <xs:complexType>
      <xs:attribute name="x" type="xs:string"/>
      <xs:attribute name="y" type="xs:string"/>
      <xs:attribute name="z" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Vector">
    <xs:complexType>
      <xs:attribute name="dx" type="xs:string"/>
      <xs:attribute name="dy" type="xs:string"/>
      <xs:attribute name="dz" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="VectorBundle">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Position"/>
        <xs:element ref="Vector"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="VectorBundle2">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="Position"/>
        <xs:element ref="Vector"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       Generic Table (indexed data array used across many elements)
       Count + e0..eN entries; allow any attribute to handle large N.
       ==================================================================== -->

  <xs:element name="Table">
    <xs:complexType>
      <xs:anyAttribute processContents="lax"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
