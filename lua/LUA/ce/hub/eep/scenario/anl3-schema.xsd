  <!-- ====================================================================
       Goods (physics objects)
       ==================================================================== -->

  <xs:element name="Goods">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Good" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="count" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="Good">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="AVel"/>
