  <xs:element name="AxisPreset">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Table" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="GroupName" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="PxActor">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Table" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="CCamDir">
    <xs:complexType>
      <xs:attribute name="x" type="xs:string"/>
      <xs:attribute name="y" type="xs:string"/>
      <xs:attribute name="z" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="CCamPos">
    <xs:complexType>
      <xs:attribute name="x" type="xs:string"/>
      <xs:attribute name="y" type="xs:string"/>
      <xs:attribute name="z" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ====================================================================
       Animated Objects (AnimRoll)
       ==================================================================== -->

  <xs:element name="AnimRoll">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="AnimElement" minOccurs="0" maxOccurs="unbounded"/>
